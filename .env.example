# 此间 - 环境变量范本 (.env.example)
# 本地开发请复制为 `.env.local` 并填入实际密钥（严禁提交真实 Key 入库）

# --- Supabase 数据库与存储 ---
# Supabase 项目 API 地址（如：https://xxx.supabase.co）
SUPABASE_URL=
# Supabase 服务端 Service Role 密钥（严禁暴露至前端）
SUPABASE_SERVICE_ROLE_KEY=
# 静态资源 Bucket 名称（默认：published-content）
PUBLISHED_ASSETS_BUCKET=published-content
# 内容库运行模式（development / production）
PUBLISHED_CONTENT_ENV=development

# --- Notion 内容发布管理 ---
# Notion Internal Integration Token
NOTION_TOKEN=
# Notion 根页面 ID (Root Page ID)
NOTION_ROOT_PAGE_ID=
# Notion 内容数据库 ID (Database ID)
NOTION_CONTENT_DATABASE_ID=
# 远程发布接口鉴权 Token (POST /api/admin/publish-notion)
PUBLICATION_ADMIN_TOKEN=
# 内容同步发布接口地址
PUBLICATION_ENDPOINT=http://localhost:3000/api/admin/publish-notion

# --- 飞书 (Lark) 卡片同步 ---
# 飞书开放平台 App ID
LARK_APP_ID=
# 飞书开放平台 App Secret
LARK_APP_SECRET=
# 飞书多维表格 Base App Token
LARK_BASE_APP_TOKEN=
# 飞书多维数据表 Table ID
LARK_BASE_TABLE_ID=
# 飞书同步接口鉴权 Secret (POST /api/sync/lark)
CRON_SECRET=

# --- AI 问答引擎配置 ---
# 回答模式 (fixture: 本地模拟 | shadow: 静默验证 | production: 生产上线)
AI_ANSWER_MODE=fixture
# 大模型服务 Base URL (推荐：https://api.deepseek.com)
AI_PROVIDER_BASE_URL=
# 大模型服务 API Key (严禁暴露至前端)
AI_PROVIDER_API_KEY=
# 聊天模型名称 (推荐：deepseek-v4-flash)
AI_CHAT_MODEL=
# Embedding 向量模型 (可选，默认使用词法召回)
AI_EMBEDDING_MODEL=
# AI 请求超时时间 (单位：ms，默认 8000)
AI_REQUEST_TIMEOUT_MS=8000
# 单 IP 每分钟请求限流次数 (默认 10)
AI_RATE_LIMIT_PER_MINUTE=10

# --- 评测与冒烟测试 (可选) ---
# 问答准确率评测接口 (用于 npm run eval:answers)
ANSWER_EVAL_ENDPOINT=http://localhost:3000/api/ask
# EdgeOne 冒烟测试端点 (用于 npm run smoke:edgeone)
EDGEONE_SMOKE_ENDPOINT=
# EdgeOne 冷启动节点测试地址 (逗号分隔，选填)
EDGEONE_COLD_START_ENDPOINTS=

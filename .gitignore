# Next.js + TypeScript Git 忽略规则 (.gitignore)

# --- 依赖与编译产物 ---
node_modules/
.next/
out/
build/
dist/
.turbo/
.vercel/
.swc/

# TypeScript 编译缓存
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts.bak

# --- 重建方案只读目录 ---
legacy code/

# --- 环境变量与私密配置 ---
.env
.env*.local
.env.production
.env.development
.env.test
.env.notion
*.download

# 允许提交环境配置范本
!.env.example
!.env.*.example

# --- 日志与进程文件 ---
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.pnpm-debug.log*
pids
*.pid
*.seed
*.pid.lock

# --- 测试与覆盖率 ---
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/

# --- 操作系统与 IDE ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# VS Code & JetBrains (放行团队共享配置)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.idea/

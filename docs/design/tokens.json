{
  "$description": "此间“现代纯净 + 墨蓝与青蓝点睛”设计令牌。实现时转换为 CSS custom properties 与 Tailwind theme tokens；不得在页面层新增同类值。",
  "color": {
    "canvas": { "$type": "color", "$value": "#FFFFFF" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surfaceSubtle": { "$type": "color", "$value": "#F8FAFC", "$comment": "浅灰卡片底色，用于公告卡与目录项" },
    "text": { "$type": "color", "$value": "#111111" },
    "textBody": { "$type": "color", "$value": "#333333" },
    "textSub": { "$type": "color", "$value": "#555555" },
    "textMuted": { "$type": "color", "$value": "#767676" },
    "border": { "$type": "color", "$value": "#ECECEC" },
    "borderMid": { "$type": "color", "$value": "#DCDCDC" },
    "action": { "$type": "color", "$value": "#111111" },
    "actionSubtle": { "$type": "color", "$value": "#F2F2F2" },
    "brandBlue": { "$type": "color", "$value": "#66CCFF", "$comment": "此间品牌主色（天依蓝），用于高亮、链接与强调" },
    "brandCyan": { "$type": "color", "$value": "#66CCFF", "$comment": "天依蓝/明亮青蓝，用于品牌辅助与重点强调" },
    "brandBlueSubtle": { "$type": "color", "$value": "rgba(102, 204, 255, 0.16)", "$comment": "品牌蓝轻柔背景与呼吸高亮" },
    "brandBlueTint": { "$type": "color", "$value": "#F0F9FF", "$comment": "品牌蓝极浅底色" },
    "info": { "$type": "color", "$value": "#66CCFF", "$comment": "提示指引，对应 Notion callout-blue" },
    "infoBg": { "$type": "color", "$value": "#F7F9FB", "$comment": "提示框浅蓝底色" },
    "warning": { "$type": "color", "$value": "#F59E0B" },
    "danger": { "$type": "color", "$value": "#DC2626", "$comment": "危险警示，对应 Notion callout-red" },
    "dangerBg": { "$type": "color", "$value": "#FEE2E2", "$comment": "警示框浅红底色" },
    "focus": { "$type": "color", "$value": "#111111" },
    "accent": { "$type": "color", "$value": "#111111", "$comment": "别名：hover/强调态，等同 action" },
    "alert": { "$type": "color", "$value": "#DC2626", "$comment": "别名：表单/弹层错误文案，等同 danger" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "12px" },
    "label": { "$type": "dimension", "$value": "14px" },
    "body": { "$type": "dimension", "$value": "15px" },
    "bodyLarge": { "$type": "dimension", "$value": "18px" },
    "title": { "$type": "dimension", "$value": "20px" },
    "heading": { "$type": "dimension", "$value": "24px" },
    "display": { "$type": "dimension", "$value": "28px" }
  },
  "fontFamily": {
    "ui": { "$type": "fontFamily", "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif" },
    "body": { "$type": "fontFamily", "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif" },
    "display": { "$type": "fontFamily", "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif" }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "lineHeight": {
    "ui": { "$type": "number", "$value": 1.4 },
    "body": { "$type": "number", "$value": 1.7 },
    "heading": { "$type": "number", "$value": 1.3 }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "8px" },
    "medium": { "$type": "dimension", "$value": "10px" },
    "large": { "$type": "dimension", "$value": "14px" },
    "card": { "$type": "dimension", "$value": "16px" },
    "round": { "$type": "dimension", "$value": "9999px" },
    "pill": { "$type": "dimension", "$value": "9999px", "$comment": "别名：胶囊徽章，等同 round" }
  },
  "size": {
    "iconSmall": { "$type": "dimension", "$value": "16px" },
    "icon": { "$type": "dimension", "$value": "18px" },
    "iconMedium": { "$type": "dimension", "$value": "20px" },
    "iconLarge": { "$type": "dimension", "$value": "24px" },
    "mascotFab": { "$type": "dimension", "$value": "50px", "$comment": "右下角纯圆形固定悬浮吉祥物球尺寸" },
    "mascotIcon": { "$type": "dimension", "$value": "34px", "$comment": "悬浮球内吉祥物矢量图标尺寸" },
    "tapTarget": { "$type": "dimension", "$value": "44px" },
    "shellMax": { "$type": "dimension", "$value": "760px", "$comment": "移动优先页面最大阅读宽度" },
    "statusAvatar": { "$type": "dimension", "$value": "64px", "$comment": "状态页/异常页大图标容器尺寸" },
    "statusCardMax": { "$type": "dimension", "$value": "320px", "$comment": "状态页说明文案最大约束宽度" },
    "modalMaxHeight": { "$type": "dimension", "$value": "82%", "$comment": "移动端底部抽屉最大可视高度" }
  },
  "borderWidth": {
    "default": { "$type": "dimension", "$value": "1px" }
  },
  "shadow": {
    "floating": { "$type": "shadow", "$value": "0 4px 16px rgba(0, 0, 0, 0.14), 0 1px 3px rgba(0, 0, 0, 0.06)" },
    "subtle": { "$type": "shadow", "$value": "0 2px 8px rgba(17, 17, 17, 0.08)", "$comment": "弱化浮层阴影，用于卡片/面板" },
    "fab": { "$type": "shadow", "$value": "0 4px 16px rgba(0, 0, 0, 0.14), 0 1px 3px rgba(0, 0, 0, 0.06)", "$comment": "小家园悬浮吉祥物球阴影" },
    "drawer": { "$type": "shadow", "$value": "0 -8px 24px rgba(0, 0, 0, 0.14)", "$comment": "底部抽屉阴影" },
    "side": { "$type": "shadow", "$value": "0 0 32px rgba(0, 0, 0, 0.16)", "$comment": "侧边抽屉阴影" }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "header": { "$type": "number", "$value": 20 },
    "floatingAction": { "$type": "number", "$value": 30 },
    "search": { "$type": "number", "$value": 38 },
    "drawerOverlay": { "$type": "number", "$value": 40 },
    "sideDrawer": { "$type": "number", "$value": 50 },
    "askSheet": { "$type": "number", "$value": 60 },
    "toast": { "$type": "number", "$value": 99 }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "240ms" },
    "highlightFlash": { "$type": "duration", "$value": "1600ms", "$comment": "AI 溯源跳转微光呼吸高亮持续时长" }
  }
}
